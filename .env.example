# Copia este archivo a ".env" (mismo directorio) y completa con tus valores
# reales antes de correr la app. "flutter_dotenv" carga este archivo como
# asset, por eso NUNCA debe commitearse el ".env" real (queda en .gitignore).
#
# La anon key de Supabase está pensada para ser pública (la seguridad real
# depende de las políticas RLS, ver supabase/schema.sql), pero de todas
# formas no se versiona para evitar acoplar el código a un proyecto
# específico y para poder rotarla sin tocar git history.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Nombre del bucket de Storage para imágenes de eventos.
SUPABASE_BUCKET_IMAGENES=imagenes

# Nombre del bucket de Storage para plantillas descargables (Excel).
SUPABASE_BUCKET_PLANTILLAS=plantillas

# URL pública donde queda publicado el build web de esta app (Flutter Web).
# Se usa para armar el enlace de autoregistro que se comparte con clientes
# desde "Registro por Cliente" (reemplaza al formulario externo del
# proyecto legado, ver Sección 17.5 de la auditoría).
APP_PUBLIC_BASE_URL=https://intranet.transworld.cl
