# Copia este archivo a `.env` y completa con los valores reales.
# El `.env` real NUNCA se versiona (ver `.gitignore`).

# Obligatorias — proyecto Supabase
SUPABASE_URL=TU_SUPABASE_URL
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# Opcionales — buckets de Storage (defaults si se omiten)
# SUPABASE_BUCKET_IMAGENES=imagenes
# SUPABASE_BUCKET_FOTOS_LEADS=leads-privados
# SUPABASE_BUCKET_PLANTILLAS=plantillas

# URL pública del subdominio de eventos (enlaces de autoregistro)
# APP_PUBLIC_BASE_URL=https://eventos.transworld.cl/
# App de administración: https://regispro.transworld.cl/

# OTA (GitHub Releases) — opcionales; hay defaults en Env
# GITHUB_OWNER=bastiansanchez24
# GITHUB_REPO=transworld_project_nexus
# UPDATE_CHANNEL=stable
