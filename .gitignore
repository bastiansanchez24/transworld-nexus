# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Local agent / IDE configs
.claude/
.cursor/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android / Gradle / Kotlin local caches (también en android/.gitignore)
android/.gradle/
android/.kotlin/
android/local.properties
android/**/GeneratedPluginRegistrant.java
android/.cxx/

# iOS / macOS local
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/
macos/Pods/

# Desktop ephemeral
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# Variables de entorno reales: NUNCA versionar (ver documentacion_zips_registro_pro.md
# Sección 17.11 sobre el .env real filtrado en el proyecto legado). Solo .env.example
# debe estar en el repositorio.
.env
.env.*
!.env.example

# Copias locales de assets OTA (alias android-nexus / windows-nexus).
/dist/

# Android release signing — nunca versionar keystore ni key.properties.
android/key.properties
*.jks
*.keystore
upload-keystore.jks

# Firebase client config (FlutterFire). No versionar valores reales.
# Stub versionado: lib/firebase_options.stub.dart (CI lo copia si no hay secret).
# firebase.json (rutas FlutterFire) sí puede versionarse.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
.firebase/
